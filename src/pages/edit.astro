---
import BaseLayout from '@layouts/BaseLayout.astro';

if (!import.meta.env.DEV) {
  return Astro.redirect('/');
}
---

<BaseLayout title="Edit profile (dev)">
  <main class="min-h-screen bg-slate-50 py-10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-8">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-amber-700 bg-amber-50 border border-amber-200 rounded-md px-2 py-1 inline-block mb-2">
            Dev only — not shipped in production
          </p>
          <h1 class="text-3xl font-bold text-slate-900">Edit profile</h1>
          <p class="text-slate-500 mt-1 text-sm">
            Saves to <code class="text-xs bg-slate-200 px-1 rounded">src/data/profile.json</code>. Preview the site, then commit when happy.
          </p>
        </div>
        <div class="flex gap-2">
          <a
            href="/"
            target="_blank"
            class="px-4 py-2 rounded-lg border border-slate-300 text-slate-700 text-sm font-medium hover:border-accent-400 hover:text-accent-600"
          >
            Preview site
          </a>
          <button
            id="save-btn"
            type="button"
            class="px-4 py-2 rounded-lg bg-accent-600 text-white text-sm font-semibold hover:bg-accent-700 shadow-sm"
          >
            Save to disk
          </button>
        </div>
      </div>

      <p id="status" class="hidden mb-4 text-sm font-medium px-3 py-2 rounded-lg"></p>

      <div id="editor" class="space-y-6">
        <p class="text-slate-500">Loading profile…</p>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  type Profile = {
    name: string;
    initials: string;
    headline: string;
    location: string;
    email: string;
    linkedin: string;
    github?: string;
    twitter?: string;
    bio: string;
    about: string;
    experience: Array<Record<string, unknown>>;
    education: Array<Record<string, unknown>>;
    skills: Array<Record<string, unknown>>;
    certifications: Array<Record<string, unknown>>;
    patents: Array<Record<string, unknown>>;
  };

  let profile: Profile;

  const editor = document.getElementById('editor')!;
  const statusEl = document.getElementById('status')!;
  const saveBtn = document.getElementById('save-btn')!;

  function setStatus(message: string, kind: 'ok' | 'err' | 'info') {
    statusEl.textContent = message;
    statusEl.classList.remove('hidden', 'bg-green-50', 'text-green-800', 'bg-red-50', 'text-red-800', 'bg-slate-100', 'text-slate-700');
    if (kind === 'ok') statusEl.classList.add('bg-green-50', 'text-green-800');
    else if (kind === 'err') statusEl.classList.add('bg-red-50', 'text-red-800');
    else statusEl.classList.add('bg-slate-100', 'text-slate-700');
  }

  function field(label: string, key: keyof Profile, multiline = false) {
    const value = String(profile[key] ?? '');
    const id = `field-${String(key)}`;
    if (multiline) {
      return `
        <label class="block">
          <span class="block text-sm font-medium text-slate-700 mb-1">${label}</span>
          <textarea id="${id}" data-key="${String(key)}" rows="6"
            class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-accent-400">${escapeHtml(value)}</textarea>
        </label>`;
    }
    return `
      <label class="block">
        <span class="block text-sm font-medium text-slate-700 mb-1">${label}</span>
        <input id="${id}" data-key="${String(key)}" type="text" value="${escapeAttr(value)}"
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-accent-400" />
      </label>`;
  }

  function escapeHtml(s: string) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function escapeAttr(s: string) {
    return escapeHtml(s).replace(/"/g, '&quot;');
  }

  function jsonArea(label: string, key: 'experience' | 'education' | 'skills' | 'certifications' | 'patents', rows = 12) {
    const value = JSON.stringify(profile[key], null, 2);
    return `
      <details class="bg-white rounded-2xl border border-slate-200 shadow-sm open:shadow-md" open>
        <summary class="cursor-pointer px-5 py-4 text-lg font-semibold text-slate-900 select-none">${label}</summary>
        <div class="px-5 pb-5">
          <p class="text-xs text-slate-500 mb-2">Edit as JSON. Invalid JSON will block save.</p>
          <textarea data-json-key="${key}" rows="${rows}"
            class="w-full font-mono text-xs rounded-lg border border-slate-300 px-3 py-2 text-slate-800 focus:outline-none focus:ring-2 focus:ring-accent-400">${escapeHtml(value)}</textarea>
        </div>
      </details>`;
  }

  function render() {
    editor.innerHTML = `
      <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6 space-y-4">
        <h2 class="text-lg font-semibold text-slate-900">Basics</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          ${field('Name', 'name')}
          ${field('Initials', 'initials')}
        </div>
        ${field('Headline', 'headline')}
        <div class="grid sm:grid-cols-2 gap-4">
          ${field('Location', 'location')}
          ${field('Email', 'email')}
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          ${field('LinkedIn', 'linkedin')}
          ${field('GitHub', 'github')}
        </div>
        ${field('Bio (short)', 'bio', true)}
        ${field('About (long)', 'about', true)}
      </section>
      ${jsonArea('Experience', 'experience', 18)}
      ${jsonArea('Education', 'education', 8)}
      ${jsonArea('Skills', 'skills', 10)}
      ${jsonArea('Certifications', 'certifications', 6)}
      ${jsonArea('Patents', 'patents', 6)}
    `;
  }

  function collectFromDom(): Profile {
    const next = { ...profile };
    editor.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-key]').forEach((el) => {
      const key = el.dataset.key as keyof Profile;
      (next as Record<string, unknown>)[key] = el.value;
    });
    editor.querySelectorAll<HTMLTextAreaElement>('[data-json-key]').forEach((el) => {
      const key = el.dataset.jsonKey as 'experience' | 'education' | 'skills' | 'certifications' | 'patents';
      try {
        next[key] = JSON.parse(el.value);
      } catch {
        throw new Error(`Invalid JSON in ${key}`);
      }
    });
    return next;
  }

  async function load() {
    const res = await fetch('/api/profile');
    if (!res.ok) throw new Error('Failed to load profile');
    profile = await res.json();
    render();
  }

  saveBtn.addEventListener('click', async () => {
    try {
      const next = collectFromDom();
      setStatus('Saving…', 'info');
      const res = await fetch('/api/profile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(next),
      });
      const payload = await res.json();
      if (!res.ok) throw new Error(payload.error || 'Save failed');
      profile = next;
      setStatus('Saved to src/data/profile.json — refresh the site preview to see changes, then commit when ready.', 'ok');
    } catch (err) {
      setStatus(err instanceof Error ? err.message : String(err), 'err');
    }
  });

  load().catch((err) => {
    editor.innerHTML = `<p class="text-red-700">${escapeHtml(String(err))}</p>`;
  });
</script>
