---
import { profile } from '@data/profile';
---

<section id="education" class="py-24 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div data-reveal class="accent-line mx-auto"></div>
      <h2 data-reveal data-reveal-delay="1" class="section-heading">Education &amp; Credentials</h2>
    </div>

    <!-- Education -->
    <div data-reveal class="mb-12">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-5">Education</h3>
      <div class="grid gap-6 w-3/4">
        {profile.education.map((edu, i) => (
          <div
            data-reveal
            data-reveal-delay={String(Math.min(i + 1, 4))}
            class="bg-gradient-to-br from-slate-50 to-accent-50 rounded-2xl border border-slate-100 p-8 hover:shadow-md transition-shadow"
          >
            <div class="w-12 h-12 rounded-xl bg-accent-100 flex items-center justify-center mb-5">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-accent-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M12 14l9-5-9-5-9 5 9 5z" />
                <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              </svg>
            </div>
            <h4 class="text-lg font-bold text-slate-900 mb-1">{edu.institution}</h4>
            <p class="text-accent-600 font-semibold text-sm mb-1">
              {edu.degree} in {edu.field}
            </p>
            <p class="text-slate-500 text-sm mb-3 flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              {edu.startDate} – {edu.endDate}
              {edu.gpa && <span class="ml-1 text-slate-400">· GPA {edu.gpa}</span>}
            </p>
            {edu.description && (
              <p class="text-slate-600 text-sm leading-relaxed">{edu.description}</p>
            )}
          </div>
        ))}
      </div>
    </div>

    <!-- Certifications & Patents -->
    <div class="grid sm:grid-cols-2 gap-10 max-w-4xl">

      <div data-reveal data-reveal-delay="1">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-5">Certifications</h3>
        <ul class="space-y-4">
          {profile.certifications.map((cert) => (
            <li class="flex items-start gap-4 p-4 rounded-xl bg-slate-50 border border-slate-100 hover:shadow-sm transition-shadow">
              <div class="w-9 h-9 rounded-lg bg-accent-100 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <div>
                <p class="font-semibold text-slate-900 text-sm">{cert.name}</p>
                {cert.issuer && <p class="text-slate-500 text-xs mt-0.5">{cert.issuer}</p>}
                {cert.year  && <p class="text-slate-400 text-xs mt-0.5">{cert.year}</p>}
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div data-reveal data-reveal-delay="2">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-5">Patents</h3>
        <ul class="space-y-4">
          {profile.patents.map((patent) => (
            <li class="flex items-start gap-4 p-4 rounded-xl bg-slate-50 border border-slate-100 hover:shadow-sm transition-shadow">
              <div class="w-9 h-9 rounded-lg bg-accent-100 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
              </div>
              <div>
                <p class="font-semibold text-slate-900 text-sm">{patent.name}</p>
                {patent.description && (
                  <p class="text-slate-500 text-xs mt-0.5 leading-relaxed">{patent.description}</p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</section>
