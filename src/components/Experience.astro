---
import { profile } from '@data/profile';
---

<section id="experience" class="py-24 bg-slate-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div data-reveal class="accent-line mx-auto"></div>
      <h2 data-reveal data-reveal-delay="1" class="section-heading">Experience</h2>
      <p data-reveal data-reveal-delay="2" class="section-subheading">My professional journey</p>
    </div>

    <!-- Timeline -->
    <div class="relative">
<div class="flex flex-col gap-10">
        {profile.experience.map((job, i) => (
          <article
            data-reveal
            data-reveal-delay={String(Math.min(i + 1, 4))}
            class="relative md:pl-6"
          >
            <!-- Card -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 sm:p-8 hover:shadow-md transition-shadow">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-4">
                <div>
                  <h3 class="text-xl font-bold text-slate-900">{job.role}</h3>
                  <p class="text-accent-600 font-semibold mt-0.5">{job.company}</p>
                  {job.location && (
                    <p class="text-slate-500 text-sm mt-1 flex items-center gap-1">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      {job.location}
                    </p>
                  )}
                </div>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-accent-50 text-accent-700 text-xs font-semibold whitespace-nowrap shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  {job.startDate} – {job.endDate}
                </span>
              </div>

              <p class="text-slate-600 leading-relaxed mb-4">{job.description}</p>

              {job.highlights && job.highlights.length > 0 && (
                <ul class="space-y-2 mb-5">
                  {job.highlights.map((h) => (
                    <li class="flex items-start gap-2 text-slate-600 text-sm">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-accent-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      {h}
                    </li>
                  ))}
                </ul>
              )}

              {job.technologies && job.technologies.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {job.technologies.map((tech) => (
                    <span class="px-2.5 py-1 text-xs font-medium rounded-md bg-slate-100 text-slate-600 border border-slate-200">
                      {tech}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
