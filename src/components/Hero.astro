---
import { profile } from '@data/profile';
---

<section
  id="hero"
  class="relative min-h-screen flex items-center overflow-hidden bg-gradient-to-br from-slate-50 via-white to-accent-50 pt-16"
>
  <!-- Decorative blobs -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-32 -right-32 w-[600px] h-[600px] rounded-full bg-accent-100 opacity-40 blur-3xl"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-32 -left-32 w-[500px] h-[500px] rounded-full bg-indigo-100 opacity-30 blur-3xl"
  ></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <div class="flex flex-col lg:flex-row items-center gap-14">

      <!-- Avatar -->
      <div data-reveal class="shrink-0">
        <img
          src="/mugshot.png"
          alt={profile.name}
          class="w-40 h-40 rounded-full object-cover shadow-2xl border-2 border-black"
        />
      </div>

      <!-- Text -->
      <div class="text-center lg:text-left">
        <h1
          data-reveal
          data-reveal-delay="2"
          class="text-5xl sm:text-6xl lg:text-7xl font-extrabold text-slate-900 leading-tight mb-4"
        >
          {profile.name}
        </h1>

        <p
          data-reveal
          data-reveal-delay="3"
          class="text-xl sm:text-2xl text-slate-600 font-light mb-5"
        >
          {profile.headline}
        </p>

        <!-- Location -->
        <p
          data-reveal
          data-reveal-delay="3"
          class="inline-flex items-center gap-1.5 text-slate-500 text-sm mb-8"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          {profile.location}
        </p>

        <!-- CTA buttons -->
        <div
          data-reveal
          data-reveal-delay="4"
          class="flex flex-wrap justify-center lg:justify-start gap-3 mb-10"
        >
          <a
            href="#contact"
            class="px-6 py-3 bg-accent-600 text-white font-semibold rounded-xl hover:bg-accent-700 transition-colors shadow-md shadow-accent-200"
          >
            Get in touch
          </a>
          <a
            href="#experience"
            class="px-6 py-3 border border-slate-300 text-slate-700 font-semibold rounded-xl hover:border-accent-400 hover:text-accent-600 transition-colors"
          >
            View experience
          </a>
        </div>

        <!-- Social links -->
        <div
          data-reveal
          data-reveal-delay="5"
          class="flex justify-center lg:justify-start gap-4"
        >
          <a
            href={profile.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="p-2.5 rounded-lg border border-slate-200 text-slate-500 hover:text-accent-600 hover:border-accent-300 transition-colors"
          >
            <!-- LinkedIn icon -->
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>

          {profile.github && (
            <a
              href={profile.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              class="p-2.5 rounded-lg border border-slate-200 text-slate-500 hover:text-accent-600 hover:border-accent-300 transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
              </svg>
            </a>
          )}

          <a
            href={`mailto:${profile.email}`}
            aria-label="Email"
            class="p-2.5 rounded-lg border border-slate-200 text-slate-500 hover:text-accent-600 hover:border-accent-300 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Scroll cue -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 hidden sm:flex flex-col items-center gap-1 text-slate-400 text-xs animate-bounce">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
      Scroll
    </div>
  </div>
</section>
