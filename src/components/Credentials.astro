---
import { profile } from '@data/profile';
---

<section id="credentials" class="py-24 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div data-reveal class="accent-line mx-auto"></div>
      <h2 data-reveal data-reveal-delay="1" class="section-heading">Credentials</h2>
      <p data-reveal data-reveal-delay="2" class="section-subheading">Certifications &amp; Patents</p>
    </div>

    <div class="grid sm:grid-cols-2 gap-10 max-w-4xl mx-auto">

      <!-- Certifications -->
      <div data-reveal data-reveal-delay="1">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-5">Certifications</h3>
        <ul class="space-y-4">
          {profile.certifications.map((cert) => (
            <li class="flex items-start gap-4 p-4 rounded-xl bg-slate-50 border border-slate-100 hover:shadow-sm transition-shadow">
              <div class="w-9 h-9 rounded-lg bg-accent-100 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <div>
                <p class="font-semibold text-slate-900 text-sm">{cert.name}</p>
                {cert.issuer && <p class="text-slate-500 text-xs mt-0.5">{cert.issuer}</p>}
                {cert.year  && <p class="text-slate-400 text-xs mt-0.5">{cert.year}</p>}
              </div>
            </li>
          ))}
        </ul>
      </div>

      <!-- Patents -->
      <div data-reveal data-reveal-delay="2">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-5">Patents</h3>
        <ul class="space-y-4">
          {profile.patents.map((patent) => (
            <li class="flex items-start gap-4 p-4 rounded-xl bg-slate-50 border border-slate-100 hover:shadow-sm transition-shadow">
              <div class="w-9 h-9 rounded-lg bg-accent-100 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
              </div>
              <div>
                <p class="font-semibold text-slate-900 text-sm">{patent.name}</p>
                {patent.description && (
                  <p class="text-slate-500 text-xs mt-0.5 leading-relaxed">{patent.description}</p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</section>
